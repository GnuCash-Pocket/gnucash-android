<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center">

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">


        <TextView
            android:id="@+id/one_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="1"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/two_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="2"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/three_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="3"
            android:textAppearance="?android:attr/textAppearanceLarge" />

    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <TextView
            android:id="@+id/four_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="4"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/five_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="5"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/six_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="6"
            android:textAppearance="?android:attr/textAppearanceLarge" />

    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <TextView
            android:id="@+id/seven_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="7"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/eight_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="8"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/nine_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="9"
            android:textAppearance="?android:attr/textAppearanceLarge" />

    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <View
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/zero_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:clickable="true"
            android:gravity="center"
            android:text="0"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <ImageButton
            android:id="@+id/delete_btn"
            android:layout_width="@dimen/passcode_btn"
            android:layout_height="@dimen/passcode_btn"
            android:layout_margin="@dimen/passcode_btn_margin"
            android:background="@drawable/numeric_button"
            android:contentDescription="\u232B"
            android:hapticFeedbackEnabled="true"
            android:src="@drawable/ic_backspace" />
    </TableRow>

</TableLayout>
